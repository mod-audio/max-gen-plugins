@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<urn:maxgen:zwabo:mirrorz>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-mirrorzz.html> ;
        modgui:stylesheet <modgui/stylesheet-mirrorzz.css> ;
        modgui:screenshot <modgui/screenshot-mirrorzz.png> ;
        modgui:thumbnail <modgui/thumbnail-mirrorzz.png> ;
        modgui:documentation <modgui/MIRRORZz.pdf> ;
        modgui:brand "Zwabo" ;
        modgui:label "MIRRORZz" ;
        modgui:model "boxy" ;
        modgui:panel "1-select-3-knobs" ;
        modgui:color "white" ;
        modgui:knob "purple" ;
        modgui:port [
	    lv2:index 0 ;
            lv2:symbol "ENV" ;
            lv2:name "ENV" ;
	] , [
            lv2:index 1 ;
            lv2:symbol "dry_wet" ;
            lv2:name "dry_wet" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "speed" ;
            lv2:name "speed" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "RandSpeed" ;
            lv2:name "RandSpeed" ;
        ] ;
    ] .